# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# Never commit real IDs or tokens.

NUXT_PUBLIC_SITE_URL=https://teven.vercel.app

# Analytics (loaded only after the visitor accepts analytics cookies)
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_GA4_ID=
NUXT_PUBLIC_HOTJAR_ID=
NUXT_PUBLIC_UMAMI_ID=
NUXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Consent — set to use Cookiebot instead of the built-in Cookie Control banner
NUXT_PUBLIC_COOKIEBOT_ID=

# Sanity CMS — leave empty to use the bundled content in /data
NUXT_PUBLIC_SANITY_PROJECT_ID=
NUXT_PUBLIC_SANITY_DATASET=production
NUXT_PUBLIC_SANITY_API_VERSION=2024-10-01
